<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_1x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_monochrome"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Top Right Gamepad Icon -->
    <ImageView
        android:id="@+id/img_1x2_gamepad"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:alpha="0.85"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_gamepad" />

    <!-- Left: Big Number (10) and GTA VI -->
    <LinearLayout
        android:id="@+id/layout_1x2_hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:gravity="start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_1x2_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="10"
            android:textColor="@color/text_white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_1x2_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="GTA VI"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right: Live Timer Row with SECONDS -->
    <LinearLayout
        android:id="@+id/layout_1x2_digits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Hours Box -->
        <LinearLayout
            android:id="@+id/box_1x2_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_inner_box_monochrome"
            android:gravity="center"
            android:minWidth="34dp"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/txt_1x2_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="10"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/unit_hours"
                android:textColor="@color/text_muted"
                android:textSize="7sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text=":"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Mins Box -->
        <LinearLayout
            android:id="@+id/box_1x2_mins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_inner_box_monochrome"
            android:gravity="center"
            android:minWidth="34dp"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/txt_1x2_mins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="45"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/unit_mins"
                android:textColor="@color/text_muted"
                android:textSize="7sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text=":"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Secs Box (ALWAYS VISIBLE!) -->
        <LinearLayout
            android:id="@+id/box_1x2_secs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_inner_box_monochrome"
            android:gravity="center"
            android:minWidth="34dp"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/txt_1x2_secs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="36"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/unit_secs"
                android:textColor="@color/text_muted"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txt_1x2_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:text="@string/status_released"
        android:textColor="@color/accent_pink"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

</RelativeLayout>
