<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_1x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_monochrome"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Top Left Days Banner -->
    <TextView
        android:id="@+id/txt_1x2_days_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/img_1x2_gamepad"
        android:layout_marginEnd="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="2 ДНЯ ДО РЕЛИЗА"
        android:textColor="@color/accent_pink"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Top Right Gamepad Icon -->
    <ImageView
        android:id="@+id/img_1x2_gamepad"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:alpha="0.85"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_gamepad" />

    <!-- Right: Live Timer Row with Live Seconds -->
    <LinearLayout
        android:id="@+id/layout_1x2_digits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Mins Box -->
        <LinearLayout
            android:id="@+id/box_1x2_mins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_inner_box_monochrome"
            android:gravity="center"
            android:minWidth="34dp"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingTop="4dp"
            android:paddingEnd="7dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/txt_1x2_mins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="45"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/unit_mins_short"
                android:textColor="@color/text_muted"
                android:textSize="7sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:text=":"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Secs Box (ALWAYS VISIBLE!) -->
        <LinearLayout
            android:id="@+id/box_1x2_secs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_inner_box_monochrome"
            android:gravity="center"
            android:minWidth="34dp"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingTop="4dp"
            android:paddingEnd="7dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/txt_1x2_secs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="36"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/unit_secs_short"
                android:textColor="@color/text_muted"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Left: Big Number (Total Hours) and GTA VI -->
    <LinearLayout
        android:id="@+id/layout_1x2_hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@id/layout_1x2_digits"
        android:layout_marginEnd="10dp"
        android:gravity="start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_1x2_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="71"
            android:textColor="@color/text_white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_1x2_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:singleLine="true"
            android:text="GTA VI"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_1x2_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:text="@string/status_released"
        android:textColor="@color/accent_pink"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

</RelativeLayout>
