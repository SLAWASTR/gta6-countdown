<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_1x1_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_monochrome"
    android:padding="12dp">

    <!-- Top Right Gamepad Icon -->
    <ImageView
        android:id="@+id/img_1x1_gamepad"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:alpha="0.85"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_gamepad" />

    <!-- Center Content: Big Days and GTA VI -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_1x1_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="10"
            android:textColor="@color/text_white"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_1x1_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="GTA VI"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Seconds Pill (Live) -->
    <TextView
        android:id="@+id/txt_1x1_time_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/bg_pill_time"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="10:45:36"
        android:textColor="@color/text_muted"
        android:textSize="8sp" />

</RelativeLayout>
