<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GTA6Countdown">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GTA6Countdown">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget 2x2: Full Countdown (Release + Preload) -->
        <receiver
            android:name=".WidgetProvider2x2"
            android:exported="true"
            android:label="@string/widget_2x2_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.slawastr.gta6countdown.ACTION_REFRESH" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_2x2" />
        </receiver>

        <!-- Widget 1x2: Compact Countdown (Release Only) -->
        <receiver
            android:name=".WidgetProvider1x2"
            android:exported="true"
            android:label="@string/widget_1x2_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.slawastr.gta6countdown.ACTION_REFRESH" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_1x2" />
        </receiver>

    </application>

</manifest>
